# Real-Time Document Intelligence & Compliance Engine
# S3/MinIO Storage Configuration
# Version: 1.0
# Date: 2026-02-03

# =============================================================================
# STORAGE ARCHITECTURE OVERVIEW
# =============================================================================

# Bucket Structure:
# 1. documents-raw/          - Original uploaded documents
# 2. documents-processed/     - OCR outputs, preprocessed text
# 3. documents-checkpoints/   - Processing stage artifacts
# 4. models/                  - ML model artifacts and versions
# 5. backups/                 - Database dumps and system backups
# 6. temp/                    - Temporary files (auto-cleanup)

# Path Structure (within each bucket):
# /{tenant_id}/{document_type}/{year}/{month}/{day}/{document_id}/{filename}

# Security:
# - Tenant isolation via IAM policies and bucket policies
# - Encryption at rest (AES-256 or KMS)
# - Object versioning for compliance and recovery
# - Access logging and audit trails

# =============================================================================
# MINIO CONFIGURATION (On-Premise Deployment)
# =============================================================================

# MinIO Server Configuration
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=${MINIO_PASSWORD}
MINIO_DOMAIN=minio.docintell.local
MINIO_SERVER_URL=https://minio.docintell.local:9000
MINIO_CONSOLE_URL=https://console.minio.docintell.local:9001

# Storage Settings
MINIO_STORAGE_PATH=/data
MINIO_CACHE_DRIVES=""
MINIO_CACHE_QUOTA=80
MINIO_CACHE_AFTER=0
MINIO_CACHE_WATERMARK_LOW=70
MINIO_CACHE_WATERMARK_HIGH=90

# Performance Settings
MINIO_SCANNER_SPEED=default
MINIO_API_REQUESTS_MAX=1000
MINIO_API_REQUESTS_DEADLINE=10s

# Security Settings
MINIO_KMS_AUTO_ENCRYPTION=on
MINIO_IDENTITY_OPENID_CONFIG_URL=""
MINIO_ETCD_ENDPOINTS=""

# =============================================================================
# AWS S3 CONFIGURATION (Cloud Deployment)
# =============================================================================

# S3 Settings
AWS_REGION=us-east-1
S3_BUCKET_PREFIX=docintell
S3_KMS_KEY_ID=${AWS_KMS_KEY_ID}
S3_STORAGE_CLASS=STANDARD_IA

# Access Settings
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_SESSION_TOKEN=${AWS_SESSION_TOKEN}

# Performance Settings
S3_MAX_RETRIES=3
S3_RETRY_MODE=adaptive
S3_MAX_BANDWIDTH=1Gb
S3_MULTIPART_THRESHOLD=64MB
S3_MULTIPART_CHUNKSIZE=16MB
